# Discover implemented profiles; new boards do not need a central switch.
set(ODRIVE_BOARDS_DIR "${CMAKE_CURRENT_LIST_DIR}/../Firmware/Boards")
file(GLOB _board_manifests RELATIVE "${ODRIVE_BOARDS_DIR}" "${ODRIVE_BOARDS_DIR}/*/board.json")
set(ODRIVE_AVAILABLE_BOARDS "")
foreach(_manifest IN LISTS _board_manifests)
    get_filename_component(_board "${_manifest}" DIRECTORY)
    if(EXISTS "${ODRIVE_BOARDS_DIR}/${_board}/board.cmake")
        list(APPEND ODRIVE_AVAILABLE_BOARDS "${_board}")
    endif()
endforeach()
set(ODRIVE_BOARD_VERSION "v3.6-56V" CACHE STRING "Board profile in Firmware/Boards")
set_property(CACHE ODRIVE_BOARD_VERSION PROPERTY STRINGS ${ODRIVE_AVAILABLE_BOARDS})
if(NOT ODRIVE_BOARD_VERSION IN_LIST ODRIVE_AVAILABLE_BOARDS)
    message(FATAL_ERROR "Unknown board '${ODRIVE_BOARD_VERSION}'. Available: ${ODRIVE_AVAILABLE_BOARDS}")
endif()
get_filename_component(odrive_board_dir "${ODRIVE_BOARDS_DIR}/${ODRIVE_BOARD_VERSION}" ABSOLUTE)
file(READ "${odrive_board_dir}/board.json" odrive_board_manifest)
foreach(_field mcu part family cmsis_device cube_project startup linker_script)
    string(JSON odrive_${_field} GET "${odrive_board_manifest}" ${_field})
endforeach()
get_filename_component(odrive_cube_project "${odrive_board_dir}/${odrive_cube_project}" ABSOLUTE)
get_filename_component(odrive_cube_dir "${odrive_cube_project}" DIRECTORY)
set(odrive_linker_script "${odrive_board_dir}/${odrive_linker_script}")
