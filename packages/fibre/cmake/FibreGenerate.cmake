function(fibre_generate_interfaces target)
    cmake_parse_arguments(ARG "TYPE_INFO" "DEFINITIONS;ROOT;OUTPUT_DIRECTORY" "" ${ARGN})
    if(NOT ARG_DEFINITIONS OR NOT ARG_ROOT)
        message(FATAL_ERROR "fibre_generate_interfaces 需要 DEFINITIONS 和 ROOT")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(module_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    if(DEFINED FIBRE_INTERFACE_GENERATOR)
        set(generator "${FIBRE_INTERFACE_GENERATOR}")
        set(templates "${FIBRE_INTERFACE_TEMPLATES}")
    else()
        set(generator "${module_dir}/../codegen/interface_generator.py")
        set(templates "${module_dir}/../codegen/templates")
    endif()
    if(NOT ARG_OUTPUT_DIRECTORY)
        set(ARG_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${target}/autogen")
    endif()
    get_filename_component(definitions "${ARG_DEFINITIONS}" ABSOLUTE)
    set(names interfaces function_stubs endpoints)
    if(ARG_TYPE_INFO)
        list(APPEND names type_info)
    endif()
    foreach(name IN LISTS names)
        set(endpoint_args)
        if(name STREQUAL "endpoints")
            set(endpoint_args --generate-endpoints "${ARG_ROOT}")
        endif()
        set(output "${ARG_OUTPUT_DIRECTORY}/${name}.hpp")
        add_custom_command(OUTPUT "${output}"
            COMMAND ${CMAKE_COMMAND} -E make_directory "${ARG_OUTPUT_DIRECTORY}"
            COMMAND Python3::Interpreter "${generator}" --definitions "${definitions}"
                --template "${templates}/${name}_template.j2" ${endpoint_args} --output "${output}"
            DEPENDS "${generator}" "${definitions}" "${templates}/${name}_template.j2"
            VERBATIM)
        target_sources(${target} PRIVATE "${output}")
    endforeach()
    target_include_directories(${target} PRIVATE "${ARG_OUTPUT_DIRECTORY}/..")
endfunction()
