{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ODrive: Build Firmware",
            "type": "shell",
            "command": "cmake -S \"${workspaceFolder}\" -B \"${workspaceFolder}/build\" -G Ninja && cmake --build \"${workspaceFolder}/build\" --target firmware --parallel",
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoLogo",
                    "-NoProfile",
                    "-File",
                    "${workspaceFolder}/build.ps1",
                    "-Target",
                    "firmware"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/Firmware"
                ]
            }
        }
    ]
}
