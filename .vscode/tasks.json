{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ODrive: Build Firmware",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-File",
                "${workspaceFolder}/build.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Firmware"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}/Firmware"]
            }
        }
    ]
}
